# =====================================================================
# Distributed File Storage System (DFSS) - Environment Configuration
# =====================================================================
# Copy this file to '.env' for local development or set these variables
# in your deployment container environment per Section 34.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Authentication & Security Secrets (Section 34)
# ---------------------------------------------------------------------

# High-entropy secret key used for signing JWT access tokens (HMAC SHA-256).
# REQUIRED: Server startup will fail loudly with a RuntimeError if unset.
# Minimum recommended length: 32 bytes (64+ characters recommended).
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-or-base64-secret-key-in-production

# Expiration lifespan for JWT session access tokens (in minutes).
# Default: 60 minutes
JWT_EXPIRY_MINUTES=60

# Expiration lifespan for JWT session refresh tokens (in days).
# Default: 7 days
JWT_REFRESH_EXPIRY_DAYS=7

# Initial administrator password for bootstrapping cluster administrative accounts.
# Optional: If specified, the cluster will provision an initial 'admin' user on first boot.
ADMIN_BOOTSTRAP_PASSWORD=BootstrapAdminPassword2026!

# ---------------------------------------------------------------------
# 2. Node & Cluster Networking
# ---------------------------------------------------------------------

# Current node human-readable name identifier (e.g. Node A, Node B, Node C)
NODE_NAME=Node A

# Current node local network bind URL
CURRENT_NODE_URL=http://localhost:8000

# Local node storage directory path for physical replica files and metadata database
STORAGE_DIR=nodes/Node1/Storage
